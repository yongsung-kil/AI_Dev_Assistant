{
  "params": [
    {"name": "alpha", "type": "float", "min": 0.5, "max": 1.0, "step": 0.05},
    {"name": "depth", "type": "int", "min": 1, "max": 8},
    {"name": "mode", "type": "choice", "values": ["a", "b"]}
  ],
  "evaluate": {
    "command": "python sim.py --alpha {alpha} --depth {depth} --mode {mode}",
    "metric_regex": "score=([0-9.eE+-]+)",
    "minimize": true,
    "timeout_seconds": 600
  },
  "search": {
    "budget": 50,
    "workers": 1,
    "seed": 0,
    "local_ratio": 0.5
  }
}
